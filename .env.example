# placedupermis.fr — variables d'environnement (backend)
# Copier ce fichier en .env, remplir avec les vraies valeurs.
# NE JAMAIS COMMITTER .env (déjà dans .gitignore).

# ─── Supabase ─── https://supabase.com/dashboard/project/<id>/settings/api
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...            # public, utilisable côté front
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...    # SECRET — jamais dans le front

# ─── Stripe ─── https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...              # sk_live_... en prod
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...            # Stripe → Developers → Webhooks → signing secret

# Les 4 prix créés dans Stripe pour le produit "placedupermis · fiche enrichie"
STRIPE_PRICE_ANNUEL_LAUNCH=price_1Q...     # 108 € / an
STRIPE_PRICE_ANNUEL_NORMAL=price_1Q...     # 228 € / an (après early bird)
STRIPE_PRICE_MENSUEL_LAUNCH=price_1Q...    # 12 € / mois
STRIPE_PRICE_MENSUEL_NORMAL=price_1Q...    # 25 € / mois

# ─── Emails transactionnels — Brevo ─── https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-...
BREVO_FROM=placedupermis.fr <bonjour@placedupermis.fr>
BREVO_REPLY_TO=eraffour@gmail.com

# ─── Site ─── URL publique (utilisée pour les liens dans emails, redirections Stripe)
SITE_URL=https://placedupermis.fr
